{
  "name": "minimal-blue",
  "publisher": "AzamAli",
  "displayName": "Minimal Blue",
  "description": "Minimal Blue is a dark, distraction-free theme for VS Code, designed for a sleek and minimal UI experience.",
  "version": "2.0.0",
  "icon": "logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AzamAliCodes/minimal-blue-vscode-theme.git"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Minimal Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/Minimal Blue-color-theme.json"
      },
      {
        "label": "Minimal Blue (Super Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/Minimal Blue Super Dark-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "minimalBlue.showWelcome",
        "title": "Minimal Blue: Show Welcome Page"
      },
      {
        "command": "minimalBlue.applySettings",
        "title": "Minimal Blue: Force Apply Settings"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "vscode:prepublish": "echo 'Prepublish step completed'",
    "package": "vsce package"
  }
}
